# ---------------------------------------------------------------------------
# GhostKey — environment. Copy to .env (gitignored) and fill in.
# ---------------------------------------------------------------------------

# RPC. Alchemy strongly preferred over a public node: the latency spike measures
# wall-clock time per phase and a public node's own variance pollutes the result.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Primary funded EOA. Holder of the confidential balance, and the delegator in
# the A6 delegation spike. Must hold Sepolia ETH.
DEPLOYER_PRIVATE_KEY=0x...

# Second EOA. The session key: the delegate in A6, and the transfer recipient in
# the latency spike. MUST be a different address from DEPLOYER_PRIVATE_KEY —
# delegator == delegate is not a valid test of delegated decryption.
# Generate with: pnpm spike:accounts
SESSION_PRIVATE_KEY=0x...

# Optional. Only needed for `hardhat verify`.
ETHERSCAN_API_KEY=

# Optional. Number of repetitions for the latency spike. Default 5.
LATENCY_RUNS=5
