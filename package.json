{
  "name": "savetogether",
  "version": "0.0.1",
  "private": true,
  "description": "Confidential no-loss prize savings on Zama FHEVM",
  "scripts": {
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spike:draw": "hardhat run spikes/draw-hcu.ts --network sepolia",
    "test": "npm run test:pool && npm run test:session",
    "keeper": "hardhat run scripts/keeper.ts --network sepolia",
    "build:packages": "npm run build -w @savetogether/sdk && npm run build -w @savetogether/console && npm run build -w @savetogether/mcp-server && npm run build -w @savetogether/hosted",
    "test:session": "hardhat test test/SaveTogetherSession.ts test/mcp.ts test/mcp-protocol.ts",
    "test:pool": "hardhat test test/ConfidentialPrizePool.ts test/access-control.ts test/frozen-surface.ts test/equality-invariants.ts test/draw-ordering.ts test/accrual.ts test/yield.ts test/replica-source.ts test/withdraw-buffer.ts test/reserve-order.ts test/phase-b.ts test/c1-indistinguishability.ts test/aa1-weight-leak.ts test/aa2-cancel-window.ts test/ab1-display.ts test/storage-cost.ts",
    "test:sepolia": "hardhat test test/d1-wrapper-revert.ts test/e1-wrap-path.ts test/sepolia-deposit.ts --network sepolia",
    "build:sdk": "npm run build -w @savetogether/sdk",
    "hosted": "node packages/hosted/dist/cli.js",
    "verify:all": "bash scripts/verify-all.sh"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "^0.5.1",
    "@openzeppelin/contracts": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.2",
    "@savetogether/console": "workspace:*",
    "@savetogether/mcp-server": "workspace:*",
    "@savetogether/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.1",
    "typescript-eslint": "^8.59.1",
    "zod": "^3.24.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
